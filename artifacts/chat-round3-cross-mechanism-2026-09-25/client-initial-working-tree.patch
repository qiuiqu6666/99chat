+      'stage': stage,
+      'spanId': spanId,
+      'parentSpanId': parentSpanId,
+      'source': source,
+      'queueWaitUs': _startedAtUs,
+      'executionUs': _clock.elapsedMicroseconds - _startedAtUs!,
+      'totalUs': _clock.elapsedMicroseconds,
+      'outcome': outcome,
