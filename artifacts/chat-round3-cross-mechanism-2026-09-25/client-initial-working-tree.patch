+    _startedAtUs = _clock.elapsedMicroseconds;
+    ChatOpenPerfLog.mark('span_start', trace: trace, extras: <String, Object?>{
+      'stage': stage,
+      'spanId': spanId,
+      'parentSpanId': parentSpanId,
