<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.14</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.chat99</groupId>
	<artifactId>server</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>server</name>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>17</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.github.tencentyun</groupId>
			<artifactId>tls-sig-api-v2</artifactId>
			<version>2.0</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.kafka</groupId>
			<artifactId>spring-kafka</artifactId>
		</dependency>

		<dependency>
			<groupId>com.googlecode.libphonenumber</groupId>
			<artifactId>libphonenumber</artifactId>
			<version>8.13.50</version>
		</dependency>

		<dependency>
			<groupId>com.squareup.okhttp3</groupId>
			<artifactId>okhttp</artifactId>
			<version>4.12.0</version>
		</dependency>

		<dependency>
			<groupId>com.aliyun.oss</groupId>
			<artifactId>aliyun-sdk-oss</artifactId>
			<version>3.18.1</version>
		</dependency>

		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>5.4.0</version>
		</dependency>

		<dependency>
			<groupId>net.coobird</groupId>
			<artifactId>thumbnailator</artifactId>
			<version>0.4.20</version>
		</dependency>

		<dependency>
			<groupId>org.sejda.imageio</groupId>
			<artifactId>webp-imageio</artifactId>
			<version>0.1.6</version>
		</dependency>

		<dependency>
			<groupId>org.bitcoinj</groupId>
			<artifactId>bitcoinj-core</artifactId>
			<version>0.17</version>
		</dependency>
		<dependency>
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcprov-jdk18on</artifactId>
			<version>1.78.1</version>
		</dependency>

		<!-- 腾讯云验证码 SDK -->
		<dependency>
			<groupId>com.tencentcloudapi</groupId>
			<artifactId>tencentcloud-sdk-java-captcha</artifactId>
			<version>3.1.1287</version>
		</dependency>

		<dependency>
			<groupId>com.aliyun</groupId>
			<artifactId>dypnsapi20170525</artifactId>
			<version>1.1.0</version>
		</dependency>

		<dependency>
			<groupId>com.eatthepath</groupId>
			<artifactId>pushy</artifactId>
			<version>0.15.4</version>
		</dependency>

		<dependency>
			<groupId>io.netty</groupId>
			<artifactId>netty-codec</artifactId>
		</dependency>
		<dependency>
			<groupId>io.netty</groupId>
			<artifactId>netty-handler</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>unpack-bootstrap-classes</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<mkdir dir="${project.build.outputDirectory}"/>
								<unzip src="${project.basedir}/scripts/bootstrap/server-0.0.1-SNAPSHOT.jar"
									dest="${project.build.directory}/bootstrap-unpack"/>
								<copy todir="${project.build.outputDirectory}" overwrite="true">
									<fileset dir="${project.build.directory}/bootstrap-unpack/BOOT-INF/classes">
										<!-- These sources are maintained locally and must not be restored from the stale bootstrap JAR. -->
										<exclude name="com/chat99/server/group/CommonGroupController*.class"/>
										<exclude name="com/chat99/server/group/CommonGroupService*.class"/>
										<exclude name="com/chat99/server/group/GroupMemberRepository*.class"/>
										<exclude name="com/chat99/server/group/GroupMember.class"/>
										<exclude name="com/chat99/server/group/GroupMember$*.class"/>
										<exclude name="com/chat99/server/group/GroupProfile.class"/>
										<exclude name="com/chat99/server/group/GroupProfile$*.class"/>
										<exclude name="com/chat99/server/group/GroupMemberController*.class"/>
										<exclude name="com/chat99/server/group/JoinApplicationMapper*.class"/>
										<exclude name="com/chat99/server/im/GroupPushAggregationService*.class"/>
										<exclude name="com/chat99/server/im/ImChatPushCallbackService*.class"/>
										<!-- 群撤回转发 Kafka：本地 webhook 调用 publishGroupRecall，勿被 bootstrap 旧 class 覆盖 -->
										<exclude name="com/chat99/server/im/ImMessageWebhookController*.class"/>
										<exclude name="com/chat99/server/messagearchive/ImMessageArchiveProducer*.class"/>
										<exclude name="com/chat99/server/messagearchive/ImChatPushKafkaConsumer*.class"/>
										<exclude name="com/chat99/server/messagearchive/MessageArchiveProperties*.class"/>
										<exclude name="com/chat99/server/messagearchive/MessageArchiveKafkaConfig*.class"/>
										<!-- IM REST 队列限流 + 本地鉴权：勿被 bootstrap 旧 class 覆盖 -->
										<exclude name="com/chat99/server/im/restqueue/**"/>
										<exclude name="com/chat99/server/im/ImAdminClient*.class"/>
										<exclude name="com/chat99/server/group/UserOwnedGroupService*.class"/>
										<exclude name="com/chat99/server/group/MeGroupCreateLimitController*.class"/>
										<!-- 加群/建群限额：本地含 joinLimitForGroupType，勿被 bootstrap 旧 class 覆盖 -->
										<exclude name="com/chat99/server/group/GroupCreateLimitConfigService*.class"/>
										<exclude name="com/chat99/server/group/GroupCreateLimitProperties*.class"/>
										<exclude name="com/chat99/server/group/GroupJoinLimitService*.class"/>
										<exclude name="com/chat99/server/group/GroupJoinLimitExceededException*.class"/>
										<exclude name="com/chat99/server/group/ImGroupBeforeJoinCallbackService*.class"/>
										<exclude name="com/chat99/server/group/ImGroupBeforeCreateCallbackService*.class"/>
										<exclude name="com/chat99/server/im/ImProperties*.class"/>
										<!-- 业务/IM 恒等：本地 ImUserIdService，禁止 bootstrap 旧映射 class / 实体 -->
										<exclude name="com/chat99/server/im/ImUserIdService*.class"/>
										<exclude name="com/chat99/server/im/UserImAccount*.class"/>
										<exclude name="com/chat99/server/im/UserImAccountRepository*.class"/>
										<exclude name="com/chat99/server/im/ImOnlineKickService*.class"/>
										<exclude name="com/chat99/server/im/ImChatPushPreviewService*.class"/>
										<!-- 钱包 IM 卡片 BeforeSend 闸门：本地源码，勿被 bootstrap 旧 class 覆盖 -->
										<exclude name="com/chat99/server/im/ImGroupBeforeSendMsgCallbackService*.class"/>
										<exclude name="com/chat99/server/im/ImC2cBeforeSendMsgCallbackService*.class"/>
										<exclude name="com/chat99/server/wallet/WalletOrderCard*.class"/>
										<!-- 软全员禁言：本地 BeforeSend 守卫 + tip 识别 + muteAll 强制 IM Off -->
										<exclude name="com/chat99/server/group/GroupMuteAllSendGuardService*.class"/>
										<exclude name="com/chat99/server/im/GroupTipImSupport*.class"/>
										<exclude name="com/chat99/server/group/GroupGovernanceService*.class"/>
										<!-- 群 IM 异步双写：本地 GroupImSyncService，勿被 bootstrap 旧 class 覆盖 -->
										<exclude name="com/chat99/server/group/GroupImSyncService*.class"/>
										<exclude name="com/chat99/server/im/ImGroupRealtimeCallbackService*.class"/>
										<!-- 生活缴费大猿人上游：本地源码，勿被 bootstrap 旧 class 覆盖 -->
										<exclude name="com/chat99/server/lifepayment/yuanren/**"/>
										<exclude name="com/chat99/server/lifepayment/LifePaymentOrderService*.class"/>
										<exclude name="com/chat99/server/lifepayment/LifePaymentOrderRepository*.class"/>
										<!-- 群 tip 离线推送文案：本地 GroupTipCustomPushSupport，勿被 bootstrap 旧 class 覆盖 -->
										<exclude name="com/chat99/server/im/GroupTipCustomPushSupport*.class"/>
										<exclude name="com/chat99/server/im/ImController*.class"/>
										<!-- 搜人频控开关：本地 SearchRateLimiter，勿被 bootstrap 旧 class 覆盖 -->
										<exclude name="com/chat99/server/user/SearchRateLimiter*.class"/>
										<!-- 按 UID 查资料（非搜人）：本地 UserProfile*，勿被 bootstrap 旧 class 覆盖 -->
										<exclude name="com/chat99/server/user/UserProfileController*.class"/>
										<exclude name="com/chat99/server/user/UserProfileService*.class"/>
										<!-- 好友通讯录 Versioned Sync：本地 FriendContact* / MeFriendsChanges*，勿被 bootstrap 旧 class 覆盖 -->
										<exclude name="com/chat99/server/user/FriendContactChange*.class"/>
										<exclude name="com/chat99/server/user/FriendContactSyncSeqAllocator*.class"/>
										<exclude name="com/chat99/server/user/FriendContactChangeWriter*.class"/>
										<exclude name="com/chat99/server/user/MeFriendsChangesService*.class"/>
										<exclude name="com/chat99/server/user/MeFriendsController*.class"/>
										<exclude name="com/chat99/server/user/UserFriendService*.class"/>
										<!-- 好友 IM SNS 双写：本地 FriendImSyncService，勿被 bootstrap 旧 class 覆盖 -->
										<exclude name="com/chat99/server/user/FriendImSyncService*.class"/>
										<!-- 好友申请：双向删后去掉 directRestore，勿被 bootstrap 旧 class 覆盖 -->
										<exclude name="com/chat99/server/user/FriendRequestService*.class"/>
										<exclude name="com/chat99/server/user/FriendRequestController*.class"/>
										<exclude name="com/chat99/server/realtime/FriendRequestRealtimePublisher*.class"/>
										<exclude name="com/chat99/server/group/GroupProfileView*.class"/>
										<exclude name="com/chat99/server/group/GroupSettings*.class"/>
										<exclude name="com/chat99/server/group/GroupGameIdService*.class"/>
										<exclude name="com/chat99/server/adminapi/AdminGroupsService*.class"/>
										<exclude name="com/chat99/server/adminapi/AdminGroupsController*.class"/>
										<exclude name="com/chat99/server/realtime/GroupRealtimeNotifier*.class"/>
										<exclude name="com/chat99/server/user/User*.class"/>
										<exclude name="com/chat99/server/push/JpushPushSender*.class"/>
								<exclude name="com/chat99/server/user/UserFriend*.class"/>
										<!-- 好友软删对账（Phase 3）：本地 Repository / SyncService / 申请历史软删，勿被 bootstrap 旧 class 覆盖 -->
										<exclude name="com/chat99/server/user/UserFriendRepository*.class"/>
										<exclude name="com/chat99/server/user/UserFriendSyncService*.class"/>
										<exclude name="com/chat99/server/user/FriendApplicationRepository*.class"/>
										<exclude name="com/chat99/server/user/FriendApplicationHistory*.class"/>
										<!-- 群域 Phase 3：成员软删/复活 + revision，本地源码勿被 bootstrap 旧 class 覆盖 -->
										<exclude name="com/chat99/server/group/GroupProjectionService*.class"/>
										<exclude name="com/chat99/server/group/GroupMemberChangeWriter*.class"/>
										<exclude name="com/chat99/server/group/MeGroupMembersChangesService*.class"/>
										<exclude name="com/chat99/server/group/MeGroupsChangesService*.class"/>
										<exclude name="com/chat99/server/group/MeGroupNoticeChangesService*.class"/>
										<exclude name="com/chat99/server/group/GroupChangeEmitter*.class"/>
										<exclude name="com/chat99/server/realtime/FriendListRealtimePublisher*.class"/>
										<exclude name="com/chat99/server/realtime/FriendListRealtimeNotifier*.class"/>
										<!-- Realtime TCP：本地 RealtimeTcpHandler 已增 queryExecutor 参数，勿用 bootstrap 旧 TcpServer -->
										<exclude name="com/chat99/server/realtime/RealtimeTcpServer*.class"/>
										<exclude name="com/chat99/server/realtime/RealtimeTcpHandler*.class"/>
										<exclude name="com/chat99/server/realtime/RealtimeQueryExecutorConfig*.class"/>
										<exclude name="com/chat99/server/realtime/RealtimePresenceQuerySupport*.class"/>
										<!-- 阿里云短信校验失败分类：本地 AliyunPnvsSmsClient，勿被 bootstrap 旧 class 覆盖 -->
										<exclude name="com/chat99/server/sms/AliyunPnvsSmsClient*.class"/>
										<exclude name="com/chat99/server/group/GroupChangedPublisher*.class"/>
										<exclude name="com/chat99/server/user/NicknameService*.class"/>
										<exclude name="com/chat99/server/notify/PlatformWalletNoticeService*.class"/>
										<exclude name="com/chat99/server/wallet/RedPacketClaimNoticeService*.class"/>
										<exclude name="com/chat99/server/wallet/RedPacketService*.class"/>
										<exclude name="com/chat99/server/wallet/RedPacketType*.class"/>
										<exclude name="com/chat99/server/wallet/RedPacketStatus*.class"/>
										<exclude name="com/chat99/server/wallet/WalletTransferService*.class"/>
										<exclude name="com/chat99/server/wallet/WalletTransferRepository*.class"/>
										<exclude name="com/chat99/server/wallet/WalletTransferStatus*.class"/>
										<exclude name="com/chat99/server/wallet/WalletTransfer.class"/>
										<exclude name="com/chat99/server/wallet/WithdrawService*.class"/>
										<!-- 提现手动结单：本地 AdminFinanceController / AdminWithdrawActionService -->
										<exclude name="com/chat99/server/adminapi/AdminFinanceController*.class"/>
										<exclude name="com/chat99/server/adminapi/AdminWithdrawActionService*.class"/>
										<!-- 生活缴费失败退款：本地 AdminLifePaymentFailRefund*，勿被同名 bootstrap class 覆盖 -->
										<exclude name="com/chat99/server/adminapi/AdminLifePaymentFailRefundController*.class"/>
										<exclude name="com/chat99/server/adminapi/AdminLifePaymentFailRefundService*.class"/>
										<exclude name="com/chat99/server/wallet/WalletWithdrawalRepository*.class"/>
										<exclude name="com/chat99/server/wallet/WalletWithdrawal.class"/>
										<exclude name="com/chat99/server/wallet/WalletLedgerRecord*.class"/>
										<exclude name="com/chat99/server/wallet/WalletLedgerRecordAssembler*.class"/>
										<exclude name="com/chat99/server/wallet/WalletController*.class"/>
										<exclude name="com/chat99/server/wallet/WalletRedPacket.class"/>
										<exclude name="com/chat99/server/wallet/WalletRedPacket$*.class"/>
										<exclude name="com/chat99/server/wallet/WalletExchangeConfig*.class"/>
										<exclude name="com/chat99/server/wallet/WalletExchangeService*.class"/>
										<exclude name="com/chat99/server/wallet/WalletAdminController*.class"/>
										<exclude name="com/chat99/server/wallet/WalletBootstrap*.class"/>
										<exclude name="com/chat99/server/common/ApiErrorMessages*.class"/>
										<exclude name="com/chat99/server/adminapi/AdminExchangeConfigService*.class"/>
										<exclude name="com/chat99/server/adminapi/AdminExchangeConfigController*.class"/>
										<!-- 红包 TCP 已停发：勿从 bootstrap 恢复旧 Publisher/Notifier -->
										<exclude name="com/chat99/server/realtime/RedPacketRealtimePublisher*.class"/>
										<exclude name="com/chat99/server/realtime/RedPacketRealtimeNotifier*.class"/>
										<exclude name="com/chat99/server/im/ImGroupRoleCache*.class"/>
										<exclude name="com/chat99/server/im/ImGroupFetchResult*.class"/>
										<exclude name="com/chat99/server/im/ImGroupInfoBatchResult*.class"/>
										<exclude name="com/chat99/server/group/GroupAccessService*.class"/>
								<exclude name="com/chat99/server/group/GroupRoleCodec*.class"/>
										<exclude name="com/chat99/server/group/GroupChangeEmitter*.class"/>
										<exclude name="com/chat99/server/group/GroupChangeEvent*.class"/>
										<exclude name="com/chat99/server/group/GroupRealtimeDetailFactory*.class"/>
										<exclude name="com/chat99/server/group/GroupDisplaySeqAllocator*.class"/>
										<exclude name="com/chat99/server/group/MeGroupsChanges*.class"/>
										<!-- 群系统通知 Inbox Sync：勿被 bootstrap 旧 class 覆盖 -->
										<exclude name="com/chat99/server/group/GroupSystemNotice*.class"/>
										<exclude name="com/chat99/server/group/GroupNoticeInbox*.class"/>
										<exclude name="com/chat99/server/group/GroupNoticeReadState*.class"/>
										<exclude name="com/chat99/server/group/MeGroupNotice*.class"/>
										<!-- 群成员游标增量 Sync：勿被 bootstrap 旧 class 覆盖 -->
										<exclude name="com/chat99/server/group/GroupMemberChange*.class"/>
										<exclude name="com/chat99/server/group/GroupMemberSync*.class"/>
										<exclude name="com/chat99/server/group/MeGroupMembersChanges*.class"/>
										<exclude name="com/chat99/server/group/GroupMemberView*.class"/>
										<exclude name="com/chat99/server/group/GroupMemberService*.class"/>
										<exclude name="com/chat99/server/group/GroupMemberController*.class"/>
										<exclude name="com/chat99/server/group/GroupMemberEnrichmentService*.class"/>
										<exclude name="com/chat99/server/group/GroupCreateService*.class"/>
										<exclude name="com/chat99/server/group/GroupProjectionTxService*.class"/>
										<exclude name="com/chat99/server/push/PushDisplayNameResolver*.class"/>
										<exclude name="com/chat99/server/group/GroupJoinService*.class"/>
										<exclude name="com/chat99/server/group/GroupJoinApplicationDismiss*.class"/>
										<exclude name="com/chat99/server/group/GroupGovernanceService*.class"/>
										<!-- 群 IM 异步双写：本地 GroupImSyncService，勿被 bootstrap 旧 class 覆盖 -->
										<exclude name="com/chat99/server/group/GroupImSyncService*.class"/>
										<exclude name="com/chat99/server/messagearchive/MessageHistoryAuthorizationService*.class"/>
										<exclude name="com/chat99/server/messagearchive/MessageHistoryService*.class"/>
										<exclude name="com/chat99/server/messagearchive/MeMessageHistoryController*.class"/>
										<exclude name="com/chat99/server/messagearchive/ImSnapshot*.class"/>
										<exclude name="com/chat99/server/messagearchive/ConversationRecent*.class"/>
										<exclude name="com/chat99/server/messagearchive/ImMessageArchiveConsumer*.class"/>
										<exclude name="com/chat99/server/messagearchive/ImMessageArchiveParser*.class"/>
										<exclude name="com/chat99/server/messagearchive/ImMessageArchiveEvent*.class"/>
										<exclude name="com/chat99/server/messagearchive/ChatMessageWriteRepository*.class"/>
										<exclude name="com/chat99/server/messagearchive/MsgIdBackfill*.class"/>
										<exclude name="com/chat99/server/realtime/GroupRealtimeOfflinePushService*.class"/>
										<exclude name="com/chat99/server/im/ImGroupRealtimeCallbackService*.class"/>
										<exclude name="com/chat99/server/group/GroupProfileService*.class"/>
										<exclude name="com/chat99/server/group/GroupProjectionService*.class"/>
										<exclude name="com/chat99/server/group/GroupPrivacyService*.class"/>
										<exclude name="com/chat99/server/group/GroupFalseDismissRestoreService*.class"/>
										<exclude name="com/chat99/server/group/GroupFalseDismissReconcileJob*.class"/>
										<exclude name="com/chat99/server/group/GroupProjectionSyncAdminController*.class"/>
										<exclude name="com/chat99/server/group/GroupProfileRepository*.class"/>
										<exclude name="com/chat99/server/group/GroupDismissProjectionRepairService*.class"/>
										<exclude name="com/chat99/server/im/ImChatPushAvatarSupport*.class"/>
										<exclude name="com/chat99/server/push/ApnsPushSender*.class"/>
										<exclude name="com/chat99/server/push/ApnsVoipPushSender*.class"/>
										<exclude name="com/chat99/server/push/PushAvatarResolver*.class"/>
										<exclude name="com/chat99/server/push/PushService*.class"/>
										<exclude name="com/chat99/server/push/PushTokenService*.class"/>
										<exclude name="com/chat99/server/push/UserPushToken*.class"/>
										<exclude name="com/chat99/server/push/UserPushTokenRepository*.class"/>
										<exclude name="com/chat99/server/push/VoipPushService*.class"/>
										<exclude name="com/chat99/server/push/VoipCallPush*.class"/>
										<exclude name="com/chat99/server/security/SecurityConfig*.class"/>
										<exclude name="com/chat99/server/security/JwtAuthFilter*.class"/>
										<!-- 设备会话索引（去 KEYS）+ Kafka lag 监控长驻 consumer：本地源码，勿被 bootstrap 旧 class 覆盖 -->
										<exclude name="com/chat99/server/security/UserSessionService*.class"/>
										<exclude name="com/chat99/server/messagearchive/ImMessageArchiveLagMonitorJob*.class"/>
										<exclude name="com/chat99/server/common/GlobalResponseWrapper*.class"/>
										<!-- 群直播独立微服务：主服仅 proxy + Integration，勿被 bootstrap 覆盖 -->
										<exclude name="com/chat99/server/grouplive/**"/>
										<exclude name="com/chat99/server/integration/IntegrationPing*.class"/>
										<!-- sangong 报表预签名 PUT / 分片：本地 class，勿被 bootstrap 旧 class 覆盖 -->
										<exclude name="com/chat99/server/integration/IntegrationReportImageController*.class"/>
										<exclude name="com/chat99/server/oss/OssClient*.class"/>
										<exclude name="com/chat99/server/integration/IntegrationGroupLive*.class"/>
										<exclude name="com/chat99/server/integration/IntegrationImGroup*.class"/>
										<exclude name="com/chat99/server/integration/IntegrationCallOpen*.class"/>
										<exclude name="com/chat99/server/integration/IntegrationWalletLiveTip*.class"/>
										<exclude name="com/chat99/server/integration/IntegrationAdminGroupLive*.class"/>
