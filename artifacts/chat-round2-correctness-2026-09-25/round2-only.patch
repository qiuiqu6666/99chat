+        (tester) async {
+      final nav = GlobalKey<NavigatorState>();
+      late BuildContext aContext, bContext, survivingContext;
+      late StateSetter rebuild;
+      var showCallers = true;
+      await tester.pumpWidget(MaterialApp(
