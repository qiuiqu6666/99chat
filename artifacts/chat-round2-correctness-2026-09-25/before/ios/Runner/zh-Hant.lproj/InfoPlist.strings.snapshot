CFBundleDisplayName = "99chat";
NSCameraUsageDescription = "為方便您將所拍攝的照片或影片發送給朋友，以及進行視訊通話，請允許我們訪問攝像頭進行拍攝照片和影片。";
NSMicrophoneUsageDescription = "為方便您發送語音訊息、拍攝影片以及音視訊通話，請允許我們使用咪高風進行錄音。";
NSPhotoLibraryUsageDescription = "用於選擇照片影片傳送給朋友；開啟相簿雲端備份後，會將授權範圍內的全部照片和影片（包括未選取的內容）自動上傳至伺服器，可在設定中關閉。";
NSContactsUsageDescription = "用於查找和匹配通訊錄好友。";
NSPhotoLibraryAddUsageDescription = "用於保存圖片或影片到相簿。";
